{"$schema":"../gen/schemas/desktop-schema.json","description":"主窗口权限：核心能力 + 文件选择对话框 + 应用数据目录（$APPDATA）内的文件读写。fs scope 只放行 $APPDATA/**，不开放任何系统目录；目录外的导入源文件走 Rust 窄命令 read_picked_file（见 src/lib.rs）。","identifier":"default","permissions":["core:default","wdio-webdriver:default","dialog:allow-open","fs:allow-read-file","fs:allow-write-file","fs:allow-read-text-file","fs:allow-write-text-file","fs:allow-exists","fs:allow-mkdir","fs:allow-remove","fs:allow-stat","fs:allow-read-dir",{"allow":["$APPDATA/*","$APPDATA/**"],"identifier":"fs:scope"}],"windows":["main"]}